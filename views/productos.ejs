<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lab 07 | Productos</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body class="app-body">

<header class="navbar">
    <div class="brand">
        <div class="logo-small">LB</div>
        <div>
            <strong>LoadBalance</strong>
            <span>LAB 07</span>
        </div>
    </div>

    <div class="user-menu">
        <div>
            <strong><%= usuario.nombre %></strong>
            <span><%= usuario.correo %></span>
        </div>

        <a href="/dashboard" class="btn-secondary">
            Dashboard
        </a>

        <a href="/logout" class="btn-logout">
            Cerrar sesión
        </a>
    </div>
</header>

<main class="main-content">

    <section class="welcome">
        <div>
            <span class="section-label">CRUD</span>
            <h1>Gestión de productos</h1>
            <p>
                Crear, consultar, modificar y eliminar productos
                desde la aplicación monolítica.
            </p>
        </div>
    </section>

    <!-- CREAR PRODUCTO -->

    <section class="crud-card">

        <div class="card-title">
            <div>
                <span class="section-label">NUEVO REGISTRO</span>
                <h2>Agregar producto</h2>
            </div>
        </div>

        <form action="/productos" method="POST" class="product-form">

            <div class="form-group">
                <label>Nombre</label>
                <input
                    type="text"
                    name="nombre"
                    placeholder="Nombre del producto"
                    required
                >
            </div>

            <div class="form-group">
                <label>Categoría</label>
                <input
                    type="text"
                    name="categoria"
                    placeholder="Ej. Tecnología"
                    required
                >
            </div>

            <div class="form-group">
                <label>Precio (S/)</label>
                <input
                    type="number"
                    name="precio"
                    min="0"
                    step="0.01"
                    placeholder="0.00"
                    required
                >
            </div>

            <div class="form-group">
                <label>Stock</label>
                <input
                    type="number"
                    name="stock"
                    min="0"
                    placeholder="0"
                    required
                >
            </div>

            <button type="submit" class="btn-primary">
                + Agregar producto
            </button>

        </form>

    </section>

    <!-- LISTADO -->

    <section class="crud-card">

        <div class="card-title">
            <div>
                <span class="section-label">INVENTARIO</span>
                <h2>Productos registrados</h2>
            </div>

            <span class="counter">
                <%= productos.length %> productos
            </span>
        </div>

        <div class="table-container">

            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                <% productos.forEach(producto => { %>

                    <tr>

                        <form
                            action="/productos/<%= producto.id %>/editar"
                            method="POST"
                        >

                            <td>
                                #<%= producto.id %>
                            </td>

                            <td>
                                <input
                                    class="table-input"
                                    type="text"
                                    name="nombre"
                                    value="<%= producto.nombre %>"
                                    required
                                >
                            </td>

                            <td>
                                <input
                                    class="table-input"
                                    type="text"
                                    name="categoria"
                                    value="<%= producto.categoria %>"
                                    required
                                >
                            </td>

                            <td>
                                <input
                                    class="table-input input-number"
                                    type="number"
                                    name="precio"
                                    value="<%= producto.precio %>"
                                    min="0"
                                    step="0.01"
                                    required
                                >
                            </td>

                            <td>
                                <input
                                    class="table-input input-number"
                                    type="number"
                                    name="stock"
                                    value="<%= producto.stock %>"
                                    min="0"
                                    required
                                >
                            </td>

                            <td class="actions">

                                <button
                                    type="submit"
                                    class="btn-edit"
                                >
                                    Guardar
                                </button>

                        </form>

                                <form
                                    action="/productos/<%= producto.id %>/eliminar"
                                    method="POST"
                                    class="delete-form"
                                    onsubmit="return confirm('¿Eliminar este producto?')"
                                >

                                    <button
                                        type="submit"
                                        class="btn-delete"
                                    >
                                        Eliminar
                                    </button>

                                </form>

                            </td>

                    </tr>

                <% }) %>

                <% if (productos.length === 0) { %>

                    <tr>
                        <td colspan="6" class="empty-table">
                            No existen productos registrados.
                        </td>
                    </tr>

                <% } %>

                </tbody>
            </table>

        </div>

    </section>

</main>

<footer>
    Laboratorio 07 · Login + CRUD · Balanceo de Carga
</footer>

</body>
</html>