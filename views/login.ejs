<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lab 07 | Iniciar sesión</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body class="login-body">

    <div class="login-container">

        <div class="login-info">
            <div class="logo">LB</div>

            <h1>LoadBalance</h1>

            <p>
                Aplicación monolítica preparada para trabajar
                con balanceo de carga y alta disponibilidad.
            </p>

            <div class="feature">
                ✓ Arquitectura monolítica
            </div>

            <div class="feature">
                ✓ Login y gestión de sesión
            </div>

            <div class="feature">
                ✓ CRUD de productos
            </div>

            <div class="feature">
                ✓ Preparada para Load Balancer
            </div>
        </div>

        <div class="login-card">

            <div class="login-header">
                <span class="badge">LAB 07</span>
                <h2>Bienvenido</h2>
                <p>Ingresa tus credenciales para continuar</p>
            </div>

            <% if (error) { %>
                <div class="alert-error">
                    <%= error %>
                </div>
            <% } %>

            <form action="/login" method="POST">

                <div class="form-group">
                    <label for="correo">Correo electrónico</label>

                    <input
                        type="email"
                        id="correo"
                        name="correo"
                        placeholder="admin@lab07.com"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="password">Contraseña</label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="••••••••"
                        required
                    >
                </div>

                <button type="submit" class="btn-primary">
                    Iniciar sesión
                </button>

            </form>

            <div class="credentials">
                <strong>Usuario de demostración</strong>
                <span>Correo: admin@lab07.com</span>
                <span>Contraseña: admin123</span>
            </div>

        </div>

    </div>

</body>
</html>